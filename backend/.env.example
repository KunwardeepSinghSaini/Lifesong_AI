PORT=4000
OPENAI_API_KEY=
FAL_KEY=

# Which service makes the music when USE_MOCK_AUDIO=false: "fal" (default) or "suno".
MUSIC_PROVIDER=
# Optional: override the fal model. Default is fal-ai/minimax-music/v2 (about $0.03 per song).
# FAL_MUSIC_MODEL=fal-ai/minimax-music/v2

# Set to true to skip paid music generation and return a sample track.
USE_MOCK_AUDIO=

# Set to true to skip OpenAI and return fixture lyrics (offline demo).
USE_MOCK_LLM=